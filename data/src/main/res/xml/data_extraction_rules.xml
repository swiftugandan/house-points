<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and higher (android:dataExtractionRules). Cloud backup only where it can be end-to-end
    encrypted (SPEC FR-45); device-to-device transfer never leaves the devices, so it is always allowed.
    noBackupFilesDir (device identity, wrapped family key) is excluded by the platform.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
